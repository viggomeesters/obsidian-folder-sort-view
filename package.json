{
  "name": "obsidian-folder-sort-view",
  "version": "0.1.5",
  "description": "Read-only alternate folder/file navigation pane with custom sorting.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "build:test": "esbuild src/tree.ts --bundle --platform=node --format=esm --outfile=dist/tree.mjs",
    "lint": "node scripts/lint.mjs && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/reveal-compat-test.mjs && node scripts/sidebar-test.mjs && npm run build:test && node --test tests/*.test.mjs && npm run build && node scripts/smoke.mjs",
    "sync:test-vault": "npm run build && node scripts/sync-test-vault.mjs",
    "smoke:cdp": "node scripts/smoke-cdp.mjs",
    "community:check": "node scripts/community-check.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.25.5",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@microsoft/eslint-plugin-sdl": {
      "eslint-plugin-n": "17.24.0"
    }
  }
}
